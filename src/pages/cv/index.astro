            const desc = m.description ? `<p class="mission-desc">${esc(m.description)}</p>` : "";
            const tasks = `<ul class="task-list">${m.tasks.map(t => `<li>${esc(t)}</li>`).join("")}</ul>`;
            const uc = m.useCases ? `<div class="usecase"><div class="usecase-label">Cas d'usage</div><ul>${m.useCases.map(u => `<li>${esc(u)}</li>`).join("")}</ul></div>` : "";
            return `<div class="mission"><div class="mission-title">${esc(m.title)}</div>${desc}${tasks}${uc}</div>`;
        }).join("");
        return `<div class="exp" data-id="${exp.id}">
            <div class="exp-head">
                <span class="exp-marker"></span>
                <div class="exp-headmain">
                    <div class="exp-title">${esc(exp.title)}</div>
                    <div class="exp-company">${esc(exp.company)}</div>
                    <div class="exp-meta">
                        <span><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>${esc(exp.period)}</span>
                        <span><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${esc(exp.location)}</span>
                    </div>
                </div>
                <span class="exp-toggle"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>
            </div>
            <div class="exp-detail">${detail}</div>
        </div>`;
    }).join("");

    document.getElementById("education").innerHTML = education.map(e =>
        `<div class="edu-item"><div class="edu-degree">${esc(e.degree)}</div><div class="edu-period">${esc(e.period)}</div><div class="edu-school">${esc(e.school)}</div></div>`).join("");

    document.getElementById("languages").innerHTML = languages.map(l =>
        `<div class="lang-item"><div class="lang-top"><span class="lang-name">${esc(l.lang)}</span><span class="lang-level">${esc(l.level)}</span></div><div class="lang-bar"><div class="lang-fill" style="width:${l.percent}"></div></div></div>`).join("");

    // Accordion: first experience open by default
    const expEls = document.querySelectorAll(".exp");
    if (expEls[0]) expEls[0].classList.add("open");
    expEls.forEach(el => {
        el.querySelector(".exp-head").addEventListener("click", () => el.classList.toggle("open"));
    });

    // Print / PDF
    function printCV() {
        document.querySelectorAll(".exp").forEach(el => el.classList.add("open"));
        setTimeout(() => window.print(), 120);
    }
    document.getElementById("printBtn").addEventListener("click", printCV);
    document.getElementById("printBtn2").addEventListener("click", printCV);

    // Theme toggle
    const root = document.documentElement;
    const themeIcon = document.getElementById("themeIcon");
    const sunPath = "M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.72 0l-.7.7M6.34 17.66l-.7.7M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z";
    const moonPath = "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z";
    const saved = localStorage.getItem("gx2c_cv_theme");
    if (saved) root.setAttribute("data-theme", saved);
    const syncIcon = () => { themeIcon.innerHTML = `<path d="${root.getAttribute("data-theme") === "dark" ? sunPath : moonPath}"/>`; };
    syncIcon();
    document.getElementById("themeToggle").addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("gx2c_cv_theme", next);
        syncIcon();
    });
    </script>
</body>
</html>

---
// Standalone CV page - no Base layout. Content identical to yahys.github.io/CV, SOTA form only.
---

<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yahya Benabdelkrim — CV | GX2C</title>
    <meta name="description" content="CV de Yahya Benabdelkrim — Consultant en Stratégie & Transformation SI. Finance de marché, Trésorerie, PMO, Intelligence Artificielle.">

    <meta property="og:title" content="Yahya Benabdelkrim — CV">
    <meta property="og:description" content="Stratégie & Transformation SI · Finance de marché · Trésorerie · PMO · Intelligence Artificielle">
    <meta property="og:type" content="profile">
    <meta property="og:url" content="https://ybcparis.com/cv">
    <meta name="theme-color" content="#0F172A">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"></noscript>

    <style is:inline>
        :root {
            --bg: #F8FAFC;
            --surface: #FFFFFF;
            --surface-2: #F1F5F9;
            --navy: #0F172A;
            --navy-2: #1E293B;
            --text: #0F172A;
            --text-2: #475569;
            --muted: #94A3B8;
            --border: #E2E8F0;
            --accent: #2563EB;
            --accent-2: #1E3A8A;
            --accent-soft: #EFF6FF;
            --ring: rgba(37,99,235,0.35);
            --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
            --radius: 16px;
            --shadow: 0 1px 2px rgba(15,23,42,0.04), 0 12px 32px -12px rgba(15,23,42,0.12);
        }

        html[data-theme="dark"] {
            --bg: #020617;
            --surface: #0F172A;
            --surface-2: #1E293B;
            --navy: #020617;
            --navy-2: #0F172A;
            --text: #F1F5F9;
            --text-2: #94A3B8;
            --muted: #64748B;
            --border: #1E293B;
            --accent: #3B82F6;
            --accent-2: #60A5FA;
            --accent-soft: rgba(59,130,246,0.12);
            --ring: rgba(59,130,246,0.4);
            --shadow: 0 1px 2px rgba(0,0,0,0.4), 0 16px 40px -16px rgba(0,0,0,0.6);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { font-size: 16px; scroll-behavior: smooth; }

        body {
            font-family: var(--sans);
            color: var(--text);
            background: var(--bg);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background 0.4s ease, color 0.4s ease;
            line-height: 1.6;
        }

        .wrap { max-width: 940px; margin: 0 auto; padding: 0 24px; }

        /* ===== NAV ===== */
        .nav {
            position: sticky; top: 0; z-index: 50;
            background: color-mix(in srgb, var(--bg) 82%, transparent);
            backdrop-filter: saturate(180%) blur(12px);
            -webkit-backdrop-filter: saturate(180%) blur(12px);
            border-bottom: 1px solid var(--border);
        }
        .nav-inner {
            max-width: 940px; margin: 0 auto; padding: 14px 24px;
            display: flex; align-items: center; justify-content: space-between; gap: 16px;
        }
        .nav-brand { display: flex; align-items: baseline; gap: 10px; }
        .nav-logo {
            font-family: var(--mono); font-weight: 600; font-size: 1.05rem;
            letter-spacing: 0.06em; color: var(--text);
        }
        .nav-tag {
            font-family: var(--mono); font-size: 0.7rem; font-weight: 500;
            letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
        }
        .nav-actions { display: flex; align-items: center; gap: 8px; }
        .icon-btn {
            width: 40px; height: 40px; border-radius: 10px;
            border: 1px solid var(--border); background: var(--surface);
            display: inline-flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-2); transition: all 0.25s ease;
        }
        .icon-btn:hover { color: var(--accent); border-color: var(--ring); transform: translateY(-1px); }
        .icon-btn svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            height: 40px; padding: 0 16px; border-radius: 10px;
            font-family: var(--sans); font-size: 0.82rem; font-weight: 600;
            letter-spacing: 0.01em; cursor: pointer; text-decoration: none;
            border: 1px solid transparent; transition: all 0.25s ease; white-space: nowrap;
        }
        .btn svg { width: 16px; height: 16px; }
        .btn-primary { background: var(--accent); color: #fff; }
        .btn-primary svg { stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .btn-primary:hover { background: var(--accent-2); transform: translateY(-1px); box-shadow: 0 8px 20px -8px var(--ring); }
        .btn-ghost { background: var(--surface); color: var(--text); border-color: var(--border); }
        .btn-ghost svg { stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .btn-ghost:hover { border-color: var(--ring); color: var(--accent); }

        /* ===== HERO ===== */
        .hero {
            margin-top: 40px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 40px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: ''; position: absolute; inset: 0; pointer-events: none;
            background: radial-gradient(600px 200px at 100% 0%, var(--accent-soft), transparent 70%);
        }
        .hero-top { display: flex; gap: 32px; align-items: center; position: relative; }
        .avatar-ring {
            flex-shrink: 0; width: 132px; height: 132px; border-radius: 50%;
            padding: 3px; background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 12px 32px -12px var(--ring);
        }
        .avatar-ring img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; background: var(--surface-2); }
        .hero-id { flex: 1; min-width: 0; }
        .hero-kicker {
            font-family: var(--mono); font-size: 0.72rem; font-weight: 500;
            letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent);
            margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
        }
        .hero-kicker .dot { width: 7px; height: 7px; border-radius: 50%; background: #22C55E; box-shadow: 0 0 0 3px rgba(34,197,94,0.2); }
        .hero-name {
            font-size: clamp(2rem, 5vw, 2.9rem); font-weight: 800; letter-spacing: -0.03em;
            line-height: 1.05; color: var(--text); margin-bottom: 10px;
        }
        .hero-role { font-size: 1.15rem; font-weight: 600; color: var(--accent); margin-bottom: 4px; }
        .hero-sub { font-size: 0.95rem; color: var(--text-2); }

        .hero-contact { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; position: relative; }
        .chip {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 8px 14px; border-radius: 999px;
            background: var(--surface-2); border: 1px solid var(--border);
            font-size: 0.82rem; color: var(--text-2); text-decoration: none;
            transition: all 0.25s ease;
        }
        .chip svg { width: 15px; height: 15px; stroke: var(--accent); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .chip.linkedin svg { fill: var(--accent); stroke: none; }
        a.chip:hover { border-color: var(--ring); color: var(--text); transform: translateY(-1px); }

        .hero-actions { display: flex; gap: 10px; margin-top: 24px; position: relative; }

        .stats {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
            margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--border);
            position: relative;
        }
        .stat { text-align: center; }
        .stat-value { font-family: var(--mono); font-size: 2rem; font-weight: 600; color: var(--accent); letter-spacing: -0.02em; }
        .stat-label { font-size: 0.78rem; color: var(--muted); margin-top: 4px; letter-spacing: 0.02em; }

        /* ===== SECTION ===== */
        .section { margin-top: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow); }
        .section-head { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
        .section-num { font-family: var(--mono); font-size: 0.78rem; font-weight: 600; color: var(--accent); }
        .section-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text); }
        .section-icon { width: 22px; height: 22px; stroke: var(--accent); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        /* ===== SKILLS ===== */
        .skill-group { margin-bottom: 20px; }
        .skill-group:last-child { margin-bottom: 0; }
        .skill-cat {
            font-family: var(--mono); font-size: 0.72rem; font-weight: 600;
            letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-2);
            margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
        }
        .skill-cat::before { content: ''; width: 14px; height: 2px; background: var(--accent); border-radius: 2px; }
        .chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .tag {
            padding: 6px 13px; border-radius: 8px; font-size: 0.82rem; font-weight: 500;
            background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
            transition: all 0.2s ease;
        }
        .tag:hover { border-color: var(--ring); color: var(--accent); transform: translateY(-1px); }
        .tag.mono { font-family: var(--mono); font-size: 0.76rem; }

        /* ===== EXPERIENCE ===== */
        .exp-list { display: flex; flex-direction: column; gap: 12px; }
        .exp {
            border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
            background: var(--surface); transition: border-color 0.25s ease;
        }
        .exp.open { border-color: var(--ring); }
        .exp-head {
            display: flex; align-items: flex-start; gap: 16px; padding: 18px 20px;
            cursor: pointer; user-select: none;
        }
        .exp-marker {
            flex-shrink: 0; width: 10px; height: 10px; margin-top: 6px; border-radius: 50%;
            border: 2px solid var(--accent); background: var(--surface);
        }
        .exp.open .exp-marker { background: var(--accent); }
        .exp-headmain { flex: 1; min-width: 0; }
        .exp-title { font-size: 1rem; font-weight: 700; color: var(--text); line-height: 1.35; }
        .exp-company { font-size: 0.9rem; font-weight: 600; color: var(--accent); margin-top: 3px; }
        .exp-meta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
        .exp-meta span { display: inline-flex; align-items: center; gap: 5px; }
        .exp-meta svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .exp-toggle {
            flex-shrink: 0; width: 28px; height: 28px; border-radius: 8px;
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--muted); transition: all 0.25s ease;
        }
        .exp-toggle svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.3s ease; }
        .exp.open .exp-toggle { color: var(--accent); }
        .exp.open .exp-toggle svg { transform: rotate(180deg); }

        .exp-detail { display: none; padding: 0 20px 20px 46px; }
        .exp.open .exp-detail { display: block; animation: reveal 0.35s ease; }
        @keyframes reveal { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }

        .mission { padding-top: 16px; margin-top: 16px; border-top: 1px dashed var(--border); }
        .mission:first-child { padding-top: 0; margin-top: 0; border-top: none; }
        .mission-title { font-size: 0.92rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
        .mission-desc { font-size: 0.85rem; color: var(--text-2); font-style: italic; margin-bottom: 10px; line-height: 1.6; }
        .task-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
        .task-list li { position: relative; padding-left: 20px; font-size: 0.86rem; color: var(--text-2); line-height: 1.55; }
        .task-list li::before { content: ''; position: absolute; left: 4px; top: 9px; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
        .usecase { margin-top: 12px; padding: 12px 14px; background: var(--accent-soft); border-radius: 10px; border: 1px solid var(--border); }
        .usecase-label { font-family: var(--mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
        .usecase ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
        .usecase li { position: relative; padding-left: 18px; font-size: 0.82rem; color: var(--text-2); }
        .usecase li::before { content: '›'; position: absolute; left: 4px; top: 0; color: var(--accent); font-weight: 700; }

        /* ===== EDU + LANG ===== */
        .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 28px; }
        .duo .section { margin-top: 0; }
        .edu-item { padding: 14px 16px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border); margin-bottom: 12px; }
        .edu-item:last-child { margin-bottom: 0; }
        .edu-degree { font-size: 0.9rem; font-weight: 700; color: var(--text); line-height: 1.4; }
        .edu-period { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); margin: 4px 0; }
        .edu-school { font-size: 0.82rem; color: var(--text-2); }
        .lang-item { margin-bottom: 18px; }
        .lang-item:last-child { margin-bottom: 0; }
        .lang-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
        .lang-name { font-weight: 600; color: var(--text); font-size: 0.9rem; }
        .lang-level { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
        .lang-bar { height: 6px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
        .lang-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--accent-2), var(--accent)); }

        /* ===== FOOTER ===== */
        .foot { max-width: 940px; margin: 40px auto; padding: 0 24px; text-align: center; }
        .foot-text { font-size: 0.8rem; color: var(--muted); }
        .foot-text a { color: var(--accent); text-decoration: none; }
        .foot-text a:hover { text-decoration: underline; }

        .toast {
            position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(20px);
            background: var(--navy); color: #fff; font-size: 0.8rem; font-weight: 500;
            padding: 12px 22px; border-radius: 10px; opacity: 0; pointer-events: none;
            transition: all 0.35s ease; z-index: 100; box-shadow: var(--shadow);
        }
        .toast.visible { opacity: 1; transform: translateX(-50%) translateY(0); }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 640px) {
            .hero { padding: 28px 22px; }
            .hero-top { flex-direction: column; text-align: center; gap: 20px; }
            .hero-kicker, .hero-contact, .hero-actions { justify-content: center; }
            .avatar-ring { width: 108px; height: 108px; }
            .section { padding: 24px 20px; }
            .duo { grid-template-columns: 1fr; gap: 20px; }
            .stat-value { font-size: 1.6rem; }
            .exp-detail { padding-left: 20px; }
            .nav-tag { display: none; }
        }

        /* ===== PRINT (A4) ===== */
        @media print {
            :root {
                --bg: #fff; --surface: #fff; --surface-2: #f5f6f8; --text: #111; --text-2: #333;
                --muted: #666; --border: #dcdfe3; --accent: #1d4ed8; --accent-2: #1e3a8a;
                --accent-soft: #eef2ff; --shadow: none;
            }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            @page { size: A4 portrait; margin: 10mm; }
            body { background: #fff; font-size: 10px; line-height: 1.35; }
            .nav, .hero-actions, .exp-toggle, .toast { display: none !important; }
            .wrap { max-width: 100%; padding: 0; }
            .hero { margin-top: 0; padding: 12px; border-radius: 8px; box-shadow: none; page-break-inside: avoid; }
            .hero::before { display: none; }
            .avatar-ring { width: 74px; height: 74px; }
            .hero-name { font-size: 1.5rem; }
            .hero-role { font-size: 0.9rem; }
            .hero-sub { font-size: 0.75rem; }
            .hero-contact { margin-top: 10px; gap: 6px; }
            .chip { padding: 3px 8px; font-size: 0.68rem; }
            .stats { margin-top: 14px; padding-top: 12px; }
            .stat-value { font-size: 1.2rem; }
            .section { margin-top: 12px; padding: 12px; border-radius: 8px; box-shadow: none; }
            .section-head { margin-bottom: 12px; break-after: avoid; page-break-after: avoid; }
            .section-title { font-size: 1rem; }
            .duo { gap: 12px; margin-top: 12px; }
            .duo .section { break-inside: avoid; page-break-inside: avoid; }
            .exp-detail { display: block !important; padding: 0 12px 12px 30px; }
            .exp { break-inside: auto; page-break-inside: auto; margin-bottom: 8px; }
            .exp-list { gap: 8px; }
            .exp-head { padding: 10px 12px; break-inside: avoid; break-after: avoid; page-break-inside: avoid; page-break-after: avoid; }
            .exp-title { font-size: 0.85rem; }
            .exp-company { font-size: 0.78rem; }
            .task-list li, .mission-desc { font-size: 0.72rem; }
            .tag { padding: 3px 8px; font-size: 0.7rem; }
            .mission { break-inside: avoid; page-break-inside: avoid; }
            .mission + .mission { margin-top: 10px; }
            .mission-title { break-after: avoid; page-break-after: avoid; }
            .skill-group, .edu-item, .lang-item { break-inside: avoid; page-break-inside: avoid; }
            .usecase { break-inside: avoid; page-break-inside: avoid; }
            p, li { orphans: 2; widows: 2; }
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="nav-inner">
            <div class="nav-brand">
                <span class="nav-logo">GX2C</span>
                <span class="nav-tag">Curriculum Vitæ</span>
            </div>
            <div class="nav-actions">
                <button class="icon-btn" id="themeToggle" aria-label="Basculer le thème">
                    <svg id="themeIcon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
                <a class="btn btn-ghost" href="https://www.linkedin.com/in/yahyabenabdelkrim/" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    LinkedIn
                </a>
                <button class="btn btn-primary" id="printBtn">
                    <svg viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
                    PDF
                </button>
            </div>
        </div>
    </nav>

    <div class="wrap">
        <!-- HERO -->
        <header class="hero">
            <div class="hero-top">
                <div class="avatar-ring">
                    <img src="https://raw.githubusercontent.com/yahys/CV/main/IMG_5847.jpg" alt="Yahya Benabdelkrim" loading="eager" width="132" height="132">
                </div>
                <div class="hero-id">
                    <div class="hero-kicker"><span class="dot"></span>Disponible · Freelance</div>
                    <h1 class="hero-name">Yahya Benabdelkrim</h1>
                    <p class="hero-role">Consultant Freelance en Stratégie &amp; Transformation SI</p>
                    <p class="hero-sub">Stratégie, PMO, Conduite du Changement · Finance &amp; Innovation IA</p>
                </div>
            </div>

            <div class="hero-contact">
